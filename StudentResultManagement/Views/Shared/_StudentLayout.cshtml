<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Student Portal</title>

    <!-- Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Project Stylesheet with Cache Buster -->
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")?v=@DateTime.Now.Ticks" />
</head>
<body class="admin-body">

    @{
        var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();
        var studentName = (Session["StudentName"]?.ToString() ?? "Student");
        var initial = !string.IsNullOrWhiteSpace(studentName) ? studentName.Substring(0, 1).ToUpper() : "S";
    }

    <!-- Student Navigation Bar -->
    <header class="app-header">
        <div class="header-container">
            <div class="header-left">
                <a href="@Url.Action("Dashboard", "Student")" class="brand-logo">
                    <span class="brand-icon">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </span>
                    <span class="brand-text">
                        <strong>Student Portal</strong>
                    </span>
                </a>
            </div>

            <div class="header-right">
                <nav class="header-nav">
                    <a href="@Url.Action("Dashboard", "Student")" 
                       class="nav-link @(currentAction == "dashboard" ? "active" : "")">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="@Url.Action("MyResult", "Student")" 
                       class="nav-link @(currentAction == "myresult" ? "active" : "")">
                        <i class="fa-solid fa-file-invoice"></i>
                        <span>Result</span>
                    </a>
                    <a href="@Url.Action("Profile", "Student")" 
                       class="nav-link @(currentAction == "profile" ? "active" : "")">
                        <i class="fa-solid fa-user"></i>
                        <span>Profile</span>
                    </a>
                </nav>

                <div class="user-pill">
                    <div class="avatar-circle" style="background: linear-gradient(135deg, #0284c7, #0369a1);">@initial</div>
                    <div class="user-details">
                        <span class="user-name">@studentName</span>
                        <span class="user-status">Enrolled</span>
                    </div>
                </div>

                <a href="@Url.Action("Logout", "Student")" class="btn-logout" title="Sign out of Student Portal">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    <span>Logout</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="main-wrapper">
        @RenderBody()
    </main>

    <!-- App Footer -->
    <footer class="app-footer">
        <div class="footer-container">
            <div class="footer-left">
                <span>Student Result Management System &copy; @DateTime.Now.Year</span>
            </div>
            <div class="footer-right">
                <span>Academic Portal</span>
            </div>
        </div>
    </footer>

</body>
</html>
