<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Student Result Management</title>

    <!-- Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Chart.js for Visual Charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <!-- Project Stylesheet with Cache Buster -->
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")?v=@DateTime.Now.Ticks" />
</head>
<body class="admin-body">

    @{
        var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLower();
        var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();
    }

    <!-- Clean Admin Navigation Bar -->
    <header class="app-header">
        <div class="header-container">
            <div class="header-left">
                <a href="@Url.Action("Dashboard", "Admin")" class="brand-logo">
                    <span class="brand-icon">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </span>
                    <span class="brand-text">
                        <strong>EduResult</strong>
                    </span>
                </a>
            </div>

            <div class="header-right">
                <nav class="header-nav">
                    <a href="@Url.Action("Dashboard", "Admin")" 
                       class="nav-link @(currentController == "admin" && currentAction == "dashboard" ? "active" : "")">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="@Url.Action("Index", "Student")" 
                       class="nav-link @(currentController == "student" ? "active" : "")">
                        <i class="fa-solid fa-user-graduate"></i>
                        <span>Students</span>
                    </a>
                    <a href="@Url.Action("Index", "Subject")" 
                       class="nav-link @(currentController == "subject" ? "active" : "")">
                        <i class="fa-solid fa-book-open"></i>
                        <span>Subjects</span>
                    </a>
                    <a href="@Url.Action("Index", "Result")" 
                       class="nav-link @(currentController == "result" ? "active" : "")">
                        <i class="fa-solid fa-file-invoice"></i>
                        <span>Results</span>
                    </a>
                </nav>

                <div class="user-pill">
                    <div class="avatar-circle">A</div>
                    <div class="user-details">
                        <span class="user-name">@(Session["AdminUsername"] ?? "Administrator")</span>
                        <span class="user-status">Online</span>
                    </div>
                </div>

                <a href="@Url.Action("Logout", "Admin")" class="btn-logout" title="Sign out of Admin panel">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    <span>Logout</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="main-wrapper">
        @RenderBody()
    </main>

    <!-- Modern App Footer -->
    <footer class="app-footer">
        <div class="footer-container">
            <p>Student Result Management System &bull; Academic Portal &copy; @DateTime.Now.Year</p>
            <div class="footer-links">
                <span>College Academic Project</span>
            </div>
        </div>
    </footer>

</body>
</html>
