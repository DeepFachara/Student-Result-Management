@{
    Layout = null;
    ViewBag.Title = "Student Result Management System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <!-- Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Project Stylesheet with Cache Buster -->
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")?v=@DateTime.Now.Ticks" />
</head>
<body class="home-body">

    <div class="home-container">
        <div class="home-hero">
            <div class="home-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <h1>Student Result Management System</h1>
            <p>
                A secure and unified academic portal for managing curriculum courses, evaluation marks, grade distributions, and student scorecards.
            </p>

            <div class="home-cards-grid">
                <!-- Student Portal Card -->
                <a href="@Url.Action("Login", "Student")" class="home-portal-card student">
                    <div>
                        <div class="home-portal-icon">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>
                        <div class="home-portal-title">Student Portal</div>
                        <div class="home-portal-desc">
                            Access your academic dashboard, track semester results, and view your profile scorecard.
                        </div>
                    </div>
                    <div class="home-portal-btn">
                        <span>Student Login</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </a>

                <!-- Admin Portal Card -->
                <a href="@Url.Action("Login", "Admin")" class="home-portal-card admin">
                    <div>
                        <div class="home-portal-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div class="home-portal-title">Admin Portal</div>
                        <div class="home-portal-desc">
                            Manage student records, configure course syllabi, enter examination marks, and review analytics.
                        </div>
                    </div>
                    <div class="home-portal-btn">
                        <span style="color: #a5b4fc;">Admin Login</span>
                        <i class="fa-solid fa-arrow-right" style="color: #a5b4fc;"></i>
                    </div>
                </a>
            </div>
        </div>
    </div>

</body>
</html>
