@model IEnumerable<StudentResultManagement.Models.Subject>

@{
    ViewBag.Title = "Manage Subjects";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-container">

    <!-- Page Header -->
    <div class="page-header">
        <div class="page-title-wrap">
            <h1>Manage Curriculum Subjects</h1>
            <p class="page-subtitle">Configure examination courses, maximum marks, and minimum passing criteria.</p>
        </div>

        <div class="page-actions">
            <a href="@Url.Action("Create", "Subject")" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i>
                <span>Add New Subject</span>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    <!-- Table Container -->
    <div class="table-container">

        <!-- Table Toolbar -->
        <div class="table-toolbar">
            <div style="font-weight:600; font-size:15px; color:var(--slate-800); display:flex; align-items:center; gap:8px;">
                <i class="fa-solid fa-book-bookmark" style="color:var(--primary);"></i>
                <span>Curriculum Courses</span>
            </div>

            <div style="font-size:13px; color:var(--slate-500); font-weight:500;">
                Total Subjects: <strong style="color:var(--slate-800);">@(Model?.Count() ?? 0)</strong>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fa-solid fa-book-open"></i>
                </div>
                <h3>No Subjects Configured</h3>
                <p>No academic subjects have been added to the syllabus yet.</p>
                <a href="@Url.Action("Create", "Subject")" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i> Add First Subject
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="modern-table" id="subjectsTable">
                    <thead>
                        <tr>
                            <th>Subject / Course Title</th>
                            <th>Maximum Marks</th>
                            <th>Passing Marks</th>
                            <th>Pass Criteria</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var subject in Model)
                        {
                            double passPct = subject.MaxMarks > 0 ? ((double)subject.PassingMarks / subject.MaxMarks * 100) : 0;
                            <tr>
                                <td>
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        <div style="width:34px; height:34px; border-radius:8px; background:#eff6ff; color:var(--primary); display:flex; align-items:center; justify-content:center; font-size:14px;">
                                            <i class="fa-solid fa-book"></i>
                                        </div>
                                        <span style="font-weight:600; color:var(--slate-900); font-size:15px;">
                                            @subject.SubjectName
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span style="font-weight:700; color:var(--slate-800);">@subject.MaxMarks</span> Marks
                                </td>
                                <td>
                                    <span style="font-weight:700; color:var(--slate-800);">@subject.PassingMarks</span> Marks
                                </td>
                                <td>
                                    <span class="badge badge-sem">
                                        @Math.Round(passPct)% required
                                    </span>
                                </td>
                                <td style="text-align:right;">
                                    <div class="action-buttons" style="justify-content: flex-end;">
                                        <a href="@Url.Action("Edit", "Subject", new { id = subject.SubjectID })" 
                                           class="btn btn-sm btn-edit" title="Edit Subject">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                            <span>Edit</span>
                                        </a>

                                        <a href="@Url.Action("Delete", "Subject", new { id = subject.SubjectID })" 
                                           class="btn btn-sm btn-danger" title="Delete Subject">
                                            <i class="fa-solid fa-trash-can"></i>
                                            <span>Delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>
