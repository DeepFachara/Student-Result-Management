@model StudentResultManagement.Models.Student

@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="page-container" style="max-width: 760px;">

    <!-- Page Header -->
    <div class="page-header">
        <div class="page-title-wrap">
            <h1>My Profile</h1>
            <p class="page-subtitle">
                Your registered student profile and academic program information.
            </p>
        </div>
        <div class="page-actions">
            <a href="@Url.Action("Dashboard", "Student")" class="btn btn-outline">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Back to Dashboard</span>
            </a>
        </div>
    </div>

    <!-- Profile Details Card -->
    <div class="custom-card" style="padding: 28px 32px;">
        
        <!-- Header with Avatar -->
        <div style="display: flex; align-items: center; gap: 18px; padding-bottom: 24px; border-bottom: 1px solid var(--slate-100);">
            <div class="avatar-circle" style="width: 58px; height: 58px; font-size: 24px; font-weight: 700; background: linear-gradient(135deg, #0284c7, #0369a1); box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);">
                @(string.IsNullOrWhiteSpace(Model.Name) ? "S" : Model.Name.Substring(0, 1).ToUpper())
            </div>
            <div>
                <h2 style="font-size: 20px; font-weight: 700; color: var(--slate-900); margin: 0 0 4px;">@Model.Name</h2>
                <span class="status-pill active" style="font-size: 11px; padding: 3px 10px;">
                    <i class="fa-solid fa-circle" style="font-size: 8px;"></i> Active Enrolled Student
                </span>
            </div>
        </div>

        <!-- Academic Info List -->
        <div style="display: flex; flex-direction: column; margin-top: 10px;">
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--slate-100); font-size: 14px;">
                <span style="color: var(--slate-500); font-weight: 500;">
                    <i class="fa-solid fa-id-card" style="margin-right: 8px; color: var(--slate-400);"></i> Enrollment Number
                </span>
                <strong style="color: var(--slate-900); font-size: 14.5px;">@Model.EnrollmentNo</strong>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--slate-100); font-size: 14px;">
                <span style="color: var(--slate-500); font-weight: 500;">
                    <i class="fa-solid fa-envelope" style="margin-right: 8px; color: var(--slate-400);"></i> Email Address
                </span>
                <strong style="color: var(--slate-900); font-size: 14.5px;">@Model.Email</strong>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--slate-100); font-size: 14px;">
                <span style="color: var(--slate-500); font-weight: 500;">
                    <i class="fa-solid fa-building-columns" style="margin-right: 8px; color: var(--slate-400);"></i> Department
                </span>
                <strong style="color: var(--slate-900); font-size: 14.5px;">@Model.Department</strong>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 0; font-size: 14px;">
                <span style="color: var(--slate-500); font-weight: 500;">
                    <i class="fa-solid fa-layer-group" style="margin-right: 8px; color: var(--slate-400);"></i> Current Semester
                </span>
                <strong style="color: var(--slate-900); font-size: 14.5px;">Semester @Model.Semester</strong>
            </div>
        </div>

    </div>

</div>
