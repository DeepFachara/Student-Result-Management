@model StudentResultManagement.Models.Student

@{
    ViewBag.Title = "Add Student";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-container">

    <div class="page-header" style="max-width: 680px; margin: 0 auto 24px;">
        <div class="page-title-wrap">
            <h1>Add New Student</h1>
            <p class="page-subtitle">Enter student academic and enrollment credentials.</p>
        </div>

        <a href="@Url.Action("Index", "Student")" class="btn btn-outline">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="form-card">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                <label class="form-label">Enrollment / Roll Number</label>
                @Html.TextBoxFor(m => m.EnrollmentNo, new { @class = "form-control", placeholder = "e.g. 21012011001", required = "required" })
                @Html.ValidationMessageFor(m => m.EnrollmentNo, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label class="form-label">Full Name</label>
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "e.g. John Doe", required = "required" })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label class="form-label">Email Address</label>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "e.g. john.doe@college.edu", required = "required" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label class="form-label">Password (for Student Portal Login)</label>
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Create a secure password", required = "required" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label class="form-label">Department / Branch</label>
                @Html.TextBoxFor(m => m.Department, new { @class = "form-control", placeholder = "e.g. Computer Science & Engineering", required = "required" })
                @Html.ValidationMessageFor(m => m.Department, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label class="form-label">Current Semester (1 - 8)</label>
                @Html.TextBoxFor(m => m.Semester, new { @class = "form-control", type = "number", min = "1", max = "8", placeholder = "1", required = "required" })
                @Html.ValidationMessageFor(m => m.Semester, "", new { @class = "text-danger" })
            </div>

            <div class="form-actions">
                <a href="@Url.Action("Index", "Student")" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i> Save Student
                </button>
            </div>
        }
    </div>

</div>
