@model StudentResultManagement.Models.StudentLoginModel

@{
    Layout = null;
    ViewBag.Title = "Student Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Login - Student Result Management</title>

    <!-- Font: Inter & Font Awesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: linear-gradient(135deg, #1e3a5f 0%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
            color: #1e293b;
        }

        .login-wrapper {
            width: 100%;
            max-width: 420px;
        }

        .login-card {
            background-color: #ffffff;
            border-radius: 14px;
            padding: 36px 30px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.35), 0 8px 10px -6px rgba(0, 0, 0, 0.2);
        }

        .login-header {
            text-align: center;
            margin-bottom: 26px;
        }

        .login-icon {
            width: 54px;
            height: 54px;
            background: linear-gradient(135deg, #1e3a5f, #2563eb);
            color: #ffffff;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 12px;
            box-shadow: 0 4px 12px rgba(30, 58, 95, 0.35);
        }

        .login-header h2 {
            font-size: 22px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 4px;
        }

        .login-header p {
            font-size: 13px;
            color: #64748b;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 6px;
        }

        .input-wrap {
            position: relative;
        }

        .input-wrap i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 15px;
        }

        .form-control {
            width: 100%;
            padding: 11px 14px 11px 40px;
            font-size: 14px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            background-color: #f8fafc;
            color: #0f172a;
            outline: none;
            transition: all 0.2s ease;
            box-sizing: border-box;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

        .validation-error {
            display: block;
            font-size: 12px;
            color: #dc2626;
            margin-top: 4px;
        }

        .login-error {
            background-color: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 13px;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-login {
            width: 100%;
            background-color: #1e3a5f;
            color: #ffffff;
            border: none;
            padding: 11px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 7px;
            cursor: pointer;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 6px;
        }

        .btn-login:hover {
            background-color: #172e4c;
        }

        .login-footer {
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid #e2e8f0;
            text-align: center;
            font-size: 13px;
            color: #64748b;
        }

        .login-footer a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 600;
        }

        .login-footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="login-wrapper">
        <div class="login-card">

            <!-- Header -->
            <div class="login-header">
                <div class="login-icon">
                    <i class="fa-solid fa-user-graduate"></i>
                </div>
                <h2>Student Portal Login</h2>
                <p>Enter your credentials to view your academic results</p>
            </div>

            <!-- Error Notice -->
            @if (ViewBag.Error != null)
            {
                <div class="login-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <!-- Login Form -->
            @using (Html.BeginForm("Login", "Student", FormMethod.Post))
            {
                <div class="form-group">
                    <label class="form-label" for="EnrollmentNo">Enrollment Number</label>
                    <div class="input-wrap">
                        <i class="fa-solid fa-id-card"></i>
                        @Html.TextBoxFor(m => m.EnrollmentNo, new {
                            @class = "form-control",
                            placeholder = "e.g. ENR1001",
                            autocomplete = "off",
                            required = "required"
                        })
                    </div>
                    @Html.ValidationMessageFor(m => m.EnrollmentNo, "", new { @class = "validation-error" })
                </div>

                <div class="form-group">
                    <label class="form-label" for="Password">Password</label>
                    <div class="input-wrap">
                        <i class="fa-solid fa-lock"></i>
                        @Html.PasswordFor(m => m.Password, new {
                            @class = "form-control",
                            placeholder = "Enter your password",
                            required = "required"
                        })
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "validation-error" })
                </div>

                <button type="submit" class="btn-login">
                    <span>Sign In</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            }

            <!-- Switch to Admin Login -->
            <div class="login-footer">
                Faculty or Administrator?
                <a href="@Url.Action("Login", "Admin")">Admin Login &rarr;</a>
            </div>

        </div>
    </div>

</body>
</html>
