@model StudentResultManagement.Models.Student

@{
    ViewBag.Title = "Edit Student";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-container">

    <div class="page-header" style="max-width: 680px; margin: 0 auto 24px;">
        <div class="page-title-wrap">
            <h1>Edit Student Details</h1>
            <p class="page-subtitle">Update student enrollment and profile information.</p>
        </div>

        <a href="@Url.Action("Index", "Student")" class="btn btn-outline">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="form-card">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.StudentID)
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                <label class="form-label">Enrollment / Roll Number</label>
                @Html.TextBoxFor(m => m.EnrollmentNo, new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(m => m.EnrollmentNo, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label class="form-label">Full Name</label>
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label class="form-label">Email Address</label>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "required" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label class="form-label">Portal Password</label>
                @Html.TextBoxFor(m => m.Password, new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label class="form-label">Department / Branch</label>
                @Html.TextBoxFor(m => m.Department, new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(m => m.Department, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label class="form-label">Semester (1 - 8)</label>
                @Html.TextBoxFor(m => m.Semester, new { @class = "form-control", type = "number", min = "1", max = "8", required = "required" })
                @Html.ValidationMessageFor(m => m.Semester, "", new { @class = "text-danger" })
            </div>

            <div class="form-actions">
                <a href="@Url.Action("Index", "Student")" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i> Update Changes
                </button>
            </div>
        }
    </div>

</div>