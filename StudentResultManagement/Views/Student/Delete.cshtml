@model StudentResultManagement.Models.Student

@{
    ViewBag.Title = "Delete Student";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-container">

    <div class="form-card" style="border-top: 4px solid var(--danger);">
        <div style="display:flex; align-items:center; gap:14px; margin-bottom:18px;">
            <div style="width:44px; height:44px; border-radius:50%; background:#fee2e2; color:var(--danger); display:flex; align-items:center; justify-content:center; font-size:20px;">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
                <h2 style="font-size:20px; font-weight:700; color:var(--slate-900);">Confirm Student Deletion</h2>
                <p style="font-size:13px; color:var(--slate-500);">This action will remove the student record and all associated examination marks permanently.</p>
            </div>
        </div>

        <div style="background-color:var(--slate-50); border:1px solid var(--slate-200); border-radius:var(--radius-md); padding:16px 20px; margin-bottom:24px;">
            <div style="display:grid; grid-template-columns:140px 1fr; gap:10px; font-size:14px;">
                <span style="color:var(--slate-500); font-weight:500;">Enrollment No:</span>
                <strong>@Model.EnrollmentNo</strong>

                <span style="color:var(--slate-500); font-weight:500;">Full Name:</span>
                <strong>@Model.Name</strong>

                <span style="color:var(--slate-500); font-weight:500;">Department:</span>
                <span>@Model.Department</span>

                <span style="color:var(--slate-500); font-weight:500;">Semester:</span>
                <span>Semester @Model.Semester</span>
            </div>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-actions" style="margin-top:0; padding-top:0; border-top:none; justify-content:space-between;">
                <a href="@Url.Action("Index", "Student")" class="btn btn-outline">
                    <i class="fa-solid fa-arrow-left"></i> Cancel & Return
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash-can"></i> Yes, Permanently Delete
                </button>
            </div>
        }
    </div>

</div>